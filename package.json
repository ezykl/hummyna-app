{
  "name": "hummyna-app",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "npm run lint --workspaces --if-present && tsc --noEmit",
    "test": "npm run test --workspaces --if-present && jest",
    "scrub": "node scripts/scrub.mjs"
  },
  "dependencies": {
    "@hummyna/hmp": "*",
    "@peculiar/webcrypto": "^1.5.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "pako": "^3.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/packages/"
    ]
  }
}
